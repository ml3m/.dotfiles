+
+        let fade = manual_track_switch_fade_out(last_frame);
+        if let Err(e) = self
+            .sink
+            .write(AudioPacket::Samples(fade), &mut self.converter)
+        {
+            error!("Unable to fade out before manual track switch: {e}");
+            self.manual_track_switch_fade_in_remaining = 0;
+        }
+    }
